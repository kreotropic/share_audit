{
  "$schema": "https://raw.githubusercontent.com/ateeducacion/nextcloud-playground/main/assets/blueprints/blueprint-schema.json",
  "meta": {
    "title": "Share Audit Dashboard Playground",
    "author": "share_audit_dashboard",
    "description": "A fresh Nextcloud in the browser with Share Audit Dashboard installed and a handful of shares already seeded, including one owned by a disabled account, so the dashboard, security alerts and orphan-shares views all have something to show."
  },
  "landingPage": "/index.php/settings/admin/share_audit_dashboard",
  "siteOptions": {
    "title": "Nextcloud + Share Audit Dashboard",
    "locale": "en",
    "timezone": "UTC"
  },
  "admin": {
    "username": "admin",
    "password": "admin",
    "email": "admin@example.com"
  },
  "steps": [
    {
      "step": "disableApp",
      "app": "firstrunwizard"
    },
    {
      "step": "setConfig",
      "app": "core",
      "key": "whatsNewEnabled",
      "value": "no"
    },
    {
      "step": "installApp",
      "appId": "share_audit_dashboard",
      "url": "https://github-proxy.exelearning.dev/?repo=kreotropic/share_audit&release=v0.4.0&asset=share_audit_dashboard-v0.4.0.tar.gz",
      "enable": true
    },
    {
      "step": "createUser",
      "username": "alice",
      "password": "alice-audit-demo",
      "displayName": "Alice Doe",
      "email": "alice@example.com"
    },
    {
      "step": "createUser",
      "username": "bob",
      "password": "bob-audit-demo",
      "displayName": "Bob Meyer",
      "email": "bob@example.com"
    },
    {
      "step": "createUser",
      "username": "carol",
      "password": "carol-audit-demo",
      "displayName": "Carol Reyes",
      "email": "carol@example.com"
    },
    {
      "step": "createGroup",
      "gid": "marketing"
    },
    {
      "step": "addUserToGroup",
      "uid": "alice",
      "gid": "marketing"
    },
    {
      "step": "addUserToGroup",
      "uid": "bob",
      "gid": "marketing"
    },
    {
      "step": "writeFile",
      "path": "data/admin/files/Q3 Financials.xlsx",
      "url": "https://raw.githubusercontent.com/kreotropic/share_audit/master/composer.lock"
    },
    {
      "step": "writeFile",
      "path": "data/alice/files/Team Photos.zip",
      "url": "https://raw.githubusercontent.com/kreotropic/share_audit/master/LICENSE"
    },
    {
      "step": "writeFile",
      "path": "data/bob/files/Meeting Notes.txt",
      "url": "https://raw.githubusercontent.com/kreotropic/share_audit/master/CHANGELOG.md"
    },
    {
      "step": "writeFile",
      "path": "data/alice/files/Campaign Brief.md",
      "url": "https://raw.githubusercontent.com/kreotropic/share_audit/master/README.md"
    },
    {
      "step": "writeFile",
      "path": "data/carol/files/Draft Contract.docx",
      "url": "https://raw.githubusercontent.com/kreotropic/share_audit/master/package-lock.json"
    },
    {
      "step": "runOcc",
      "args": [
        "files:scan",
        "--all"
      ]
    },
    {
      "step": "login",
      "username": "admin",
      "password": "admin"
    },
    {
      "step": "createShare",
      "path": "/Q3 Financials.xlsx",
      "shareType": "public"
    },
    {
      "step": "login",
      "username": "alice",
      "password": "alice-audit-demo"
    },
    {
      "step": "createShare",
      "path": "/Team Photos.zip",
      "shareType": "public"
    },
    {
      "step": "createShare",
      "path": "/Campaign Brief.md",
      "shareType": "group",
      "shareWith": "marketing",
      "permissions": "read"
    },
    {
      "step": "login",
      "username": "bob",
      "password": "bob-audit-demo"
    },
    {
      "step": "createShare",
      "path": "/Meeting Notes.txt",
      "shareType": "user",
      "shareWith": "alice",
      "permissions": "read"
    },
    {
      "step": "login",
      "username": "carol",
      "password": "carol-audit-demo"
    },
    {
      "step": "createShare",
      "path": "/Draft Contract.docx",
      "shareType": "public"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "admin"
    },
    {
      "step": "runOcc",
      "args": [
        "user:disable",
        "carol"
      ]
    }
  ]
}
